# PiPass — example environment variables
#
# This file is checked into git. It contains PLACEHOLDER values only.
# The real values live in Replit Secrets (in Replit) or in a local
# .env file (locally; .env is gitignored).
#
# Copy this file to .env when setting up a local checkout:
#   cp .env.example .env
# Then fill in real values. NEVER commit a populated .env.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Used by both the Express server
# (server/db.ts) and Drizzle's migration tool (drizzle.config.ts).
# The server fails fast at startup if this is missing or unreachable.
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
#
# Inside Replit, this is provisioned for you and uses an internal
# hostname (e.g. "helium") that ONLY resolves from inside the Replit
# container. From a local Windows / macOS / Linux machine that
# hostname will fail with `getaddrinfo ENOTFOUND helium`.
#
# For local development, point this at an EXTERNALLY-REACHABLE
# Postgres instance — see LOCAL_DATABASE_SETUP.md for options
# (Neon, Supabase, Render, local Docker, etc.).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# At-rest encryption key for users' TOTP (2FA) secrets.
# The server REFUSES to start if this is missing or malformed.
# Must decode to exactly 32 bytes — either:
#   - 64 hex characters, OR
#   - base64 of 32 bytes
#
# Generate a fresh value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# IMPORTANT: do NOT reuse SESSION_SECRET, DATABASE_URL, or any
# other secret as the source. Rotating this key without a planned
# re-enrollment will invalidate every user's 2FA enrollment.
TOTP_ENCRYPTION_KEY=replace-with-64-hex-chars-or-base64-of-32-bytes

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Legacy session secret. NOT used for session signing in this codebase
# (sessions are random bearer tokens hashed in the database) — left in
# place only because some downstream tooling may read it. Safe to omit.
# SESSION_SECRET=replace-with-a-random-string

# Node environment. The server defaults to "development" via the
# `npm run server:dev` script. Production deployments should set this
# to "production".
# NODE_ENV=development

# Port the Express server listens on. Defaults to 5000.
# PORT=5000
