# Local backend configuration
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
SESSION_SECRET=replace-with-a-long-random-secret
TOTP_ENCRYPTION_KEY=replace-with-64-hex-characters
PORT=5000
NODE_ENV=development
DISABLE_RATE_LIMIT=false

# Public Expo client configuration
EXPO_PUBLIC_API_URL=http://localhost:5000
EXPO_PUBLIC_DOMAIN=https://your-domain.example

# Replit/deployment domains
REPLIT_DEV_DOMAIN=your-replit-dev-domain
REPLIT_DOMAINS=your-deployed-domain
