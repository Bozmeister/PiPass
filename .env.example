# Public Expo client configuration
EXPO_PUBLIC_API_URL=http://localhost:5000

# IntentDB switches. Default off. Set a value to 1 only in a debug build.
# Do not set these in a Play build. Details: README.md
# EXPO_PUBLIC_INTENTDB_ITEM_UPLOAD=1
#   Upload a staged ciphertext manifest or tombstone. Required before move or replicate.
# EXPO_PUBLIC_INTENTDB_BOT_MOVE=1
#   After a phone-locator manifest upload, propose a move to tier-1, or a replicate copy.
# EXPO_PUBLIC_INTENTDB_VERIFY=1
#   Re-check the latest receipt. A mismatch does not change the phone item.
# EXPO_PUBLIC_INTENTDB_ENVELOPE=1
#   New items wrap a random item key on device. Does not upload and does not migrate by itself.
# EXPO_PUBLIC_INTENTDB_RECEIPT_PUBLIC_KEY=
#   64 hex chars. Receipt pin. Not a feature switch. Leave empty to keep verification unpinned.
# EXPO_PUBLIC_PIPASS_ACCOUNT_DELETE=1
#   Allow DELETE /api/account. Local wipe runs only after HTTP 204. Not an INTENTDB switch.

# Replit/deployment fallback used when EXPO_PUBLIC_API_URL is not set
EXPO_PUBLIC_DOMAIN=your-app.example.com
REPLIT_DEV_DOMAIN=your-replit-dev-domain.example.com
REPLIT_DOMAINS=your-production-domain.example.com

# Local backend configuration
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/pipass

# Optional: load DATABASE_URL from a file instead of the environment
# (Docker / Kubernetes secret mount). Used only when DATABASE_URL is unset.
# DATABASE_URL_FILE=/run/secrets/database_url

# Database TLS. Auto (default):
#   - production + remote host → verify-full (encrypt + verify CA)
#   - localhost / 127.0.0.1     → disable (local Postgres, Cloud SQL proxy)
#   - URL sslmode=…             → honored when DATABASE_SSL is unset
# Values: disable | require | verify-full | auto
# Production refuses disable against a remote host unless
# DATABASE_SSL_ALLOW_INSECURE=true (not recommended).
# DATABASE_SSL=auto
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DATABASE_SSL_CA_FILE=/run/secrets/rds-ca.pem

# Shared rate-limit / soft-lock / IP-threat store.
# Leave unset for local development and tests — the server falls back to
# process memory (same policy, not shared across instances, lost on restart).
# Production / multi-instance: set this so limits survive restart and are
# shared. If Redis is configured but unreachable, auth rate limits, vault
# write soft-lock checks, and login IP blocks fail CLOSED (requests are
# rejected). Anomaly / failure-burst writes fail OPEN (skip the signal).
# Example: redis://127.0.0.1:6379
# REDIS_URL=

# Generate a fresh 32-byte key for local development:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=replace_with_64_hex_chars
