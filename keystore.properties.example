# Copy to android/app/keystore.properties (gitignored) for local release builds.
# Do NOT commit real passwords.
#
# Alternative: set environment variables (same names without file):
#   PIPASS_UPLOAD_STORE_PASSWORD
#   PIPASS_UPLOAD_KEY_PASSWORD
#   PIPASS_UPLOAD_KEY_ALIAS          (optional, default: upload)
#   PIPASS_UPLOAD_STORE_FILE         (optional, default: upload-keystore.jks)
#
# Place the JKS at: android/app/upload-keystore.jks
# storeFile may be a filename or an absolute path. Relative names are
# resolved against android/app/ first.

storeFile=upload-keystore.jks
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=upload
keyPassword=REPLACE_WITH_KEY_PASSWORD
