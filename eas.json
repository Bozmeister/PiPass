{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.pipass.app",
        "EXPO_USE_COMMUNITY_AUTOLINKING": "1",
        "NPM_INSTALL_FLAGS": "--legacy-peer-deps"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "NPM_INSTALL_FLAGS": "--legacy-peer-deps"
      }
    }
  }
}