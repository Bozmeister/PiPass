# PiPass — example test environment variables
#
# Placeholders only. Copy to .env.test for local use:
#   cp .env.test.example .env.test
# .env.test is covered by .gitignore (.env*.local pattern would NOT
# catch it — see TEST_DATABASE_SETUP.md for how to load it).
# NEVER commit a populated .env.test.
#
# This file documents the variables tests SHOULD use.
# The current test suite (server/__tests__/security.test.ts) does
# NOT yet read TEST_DATABASE_URL — it falls back to DATABASE_URL.
# Wiring tests to prefer TEST_DATABASE_URL is a follow-up task; see
# TEST_DATABASE_SETUP.md for the recommended one-line change.

# ---------------------------------------------------------------------------
# Recommended for tests
# ---------------------------------------------------------------------------

# Dedicated Postgres connection string used ONLY by the test suite.
# MUST point at a database whose contents you are willing to lose.
# The test suite writes real rows (users, sessions, audit_log, etc.)
# and does not currently clean up after itself — running it against
# your dev or prod database will pollute it with test data over time.
TEST_DATABASE_URL=postgresql://user:password@host:5432/pipass_test

# Test-only TOTP encryption key. A throwaway value is fine here
# because no user data lives in the test DB. Still must be 32 bytes.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=replace-with-64-hex-chars-or-base64-of-32-bytes
