{
  "name": "expo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "patch-package",
    "expo:dev": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN:5000 npx expo start --localhost",
    "server:dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "expo:start:static:build": "npx expo start --no-dev --minify --localhost",
    "expo:static:build": "node scripts/build.js",
    "server:build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=server_dist",
    "server:prod": "cross-env NODE_ENV=production node server_dist/index.js",
    "db:push": "drizzle-kit push",
    "db:push:test": "node scripts/db-push-test.mjs",
    "start": "npx expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node --env-file-if-exists=.env --env-file-if-exists=.env.test --import ./server/__tests__/setup-env.js --import tsx --test --test-force-exit server/__tests__/security.test.ts server/__tests__/securityStore.test.ts server/__tests__/dbConfig.test.ts workers/__tests__/storage-reset.test.ts crypto/__tests__/kdf-mode.test.ts crypto/__tests__/nativeArgon2.test.ts plugins/__tests__/withNativeArgon2.test.js plugins/__tests__/withReleaseSigning.test.js crypto/__tests__/encryption-gcm.test.ts crypto/__tests__/secure-note-label.test.ts crypto/__tests__/vaultKeyProof.test.ts lib/__tests__/screenCaptureProtection.test.ts lib/__tests__/secureClipboard.test.ts lib/__tests__/webVaultPolicy.test.ts plugins/__tests__/withMinimalAndroidPermissions.test.js plugins/__tests__/withSensitiveClipboard.test.js lib/intentdb/__tests__/itemManifest.test.ts lib/intentdb/__tests__/receipt.test.ts workers/__tests__/intentdbOutbox.test.ts server/__tests__/vaultItems.test.ts lib/intentdb/__tests__/uploadItem.test.ts lib/intentdb/__tests__/tombstoneUpload.test.ts lib/intentdb/__tests__/deleteAccount.test.ts server/__tests__/vaultItemTombstone.test.ts server/__tests__/accountDelete.test.ts lib/intentdb/__tests__/retrievalToken.test.ts lib/intentdb/__tests__/syncOutbox.test.ts server/__tests__/retrievalToken.test.ts lib/intentdb/__tests__/verifyItemReceipt.test.ts server/__tests__/itemReceipt.test.ts lib/intentdb/__tests__/moveItem.test.ts server/__tests__/itemMove.test.ts lib/intentdb/__tests__/intentBot.test.ts server/__tests__/intentBot.test.ts lib/intentdb/__tests__/intentBotReplicate.test.ts server/__tests__/itemReplicate.test.ts crypto/__tests__/itemEnvelope.test.ts lib/__tests__/vaultSearch.test.ts lib/intentdb/__tests__/verifyBot.test.ts",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix"
  },
