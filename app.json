{
  "expo": {
    "name": "PiPass",
    "slug": "pipass",
    "version": "1.5",
    "description": "Zero-knowledge password manager with strong local encryption, biometric unlock, and optional end-to-end encrypted sync. Your passwords never leave your device in plaintext.",
    "privacyPolicyUrl": "https://pipass.app/privacy",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pipass",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "jsEngine": "jsc",
      "supportsTablet": false,
      "bundleIdentifier": "com.pipass.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "PiPass uses Face ID to securely unlock your vault."
      },
      "entitlements": {
        "keychain-access-groups": [
          "group.com.pipass.shared"
        ]
      }
    },
    "android": {
      "package": "com.pipass.app",
      "versionCode": 12,
      "permissions": [],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://pipass.app"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "buildArchs": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"]
          }
        }
      ],
      "./plugins/withFlagSecure",
      "./plugins/withNativeArgon2"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "install": {
      "exclude": ["react-native-reanimated"]
    },
    "extra": {
      "router": {
        "origin": "https://pipass.app"
      },
      "eas": {
        "projectId": "b76255a9-c6e5-4e73-998a-49b365479ee4"
      }
    },
    "owner": "bozmeister"
  }
}
